{
  "manifest_version": 3,
  "name": "Steam Web Extension",
  "version": "0.1.0",
  "description": "Steam Web Extension for enhanced trading experience.",
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
     "default_icon": {
      "64": "icons/icon64.png"
     }
  }
}